{
  "languages": {
    "Python": {
      "language_servers": ["pyrefly", "ruff", "!pyright", "!basedpyright"],
      "format_on_save": "on",
      "formatter": [
        { "code_actions": { "source.organizeImports.ruff": true, "source.fixAll.ruff": true } },
        { "language_server": { "name": "ruff" } }
      ],
    },
  },
  "lsp": {
    "pyrefly": {
      "binary": {
        "path": ".venv/bin/pyrefly",
        "arguments": ["lsp"],
      },
    },
    "ruff": {
      "settings": {
        "interpreter": [".venv/bin/python"],
      },
    },
  },
}
